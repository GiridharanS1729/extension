{
    "manifest_version": 3,
    "name": "Local AI Helper",
    "version": "1.0.0",
    "description": "Personal local AI helper",
    "action": {
        "default_popup": "popup/popup.html"
    },
    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "storage",
        "sidePanel"
    ],
    "commands": {
        "copy-output": {
            "suggested_key": {
                "default": "Ctrl+Shift+K"
            },
            "description": "Copy AI output"
        }
    }
}