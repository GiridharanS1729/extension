{
    "manifest_version": 3,
    "name": "Smart Tab Sleeper Pro",
    "version": "4.2.0",
    "description": "Sleep idle tabs, track RAM usage, analytics and whitelist safe sites.",
    "permissions": [
        "tabs",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    }
}